NODE_ENV=production
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auth_app
DB_PASSWORD=
DB_NAME=auth

COOKIE_DOMAIN=.wsestudio.net
BASE_URL=https://auth.wsestudio.net
POST_LOGIN_REDIRECT=https://wsestudio.net

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://auth.wsestudio.net/auth/google/callback

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://auth.wsestudio.net/auth/kakao/callback

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

ALLOWED_ORIGINS=https://wsestudio.net,https://hub.wsestudio.net,http://localhost:5173
